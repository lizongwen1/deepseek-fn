#!/bin/bash
# 飞牛 fnOS 生命周期脚本：status 检查容器是否真正在运行
CONTAINER_NAME="deepseek-harness"

is_running() {
  docker inspect "$CONTAINER_NAME" 2>/dev/null | grep -q '"Status": "running"'
}

case "$1" in
  start)
    # Docker 应用由 fnOS 根据 docker-compose 管理，无需额外操作
    exit 0
    ;;
  stop)
    exit 0
    ;;
  status)
    if is_running; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
